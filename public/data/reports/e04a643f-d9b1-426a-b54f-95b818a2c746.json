        {
          "id": "ac-2",
          "text": "SOA研究指出，簡易核保的風險區隔工具較少，早期死亡率與解約差異較大。",
          "evidence_scheme": "actuarial_tier",
          "evidence_level": "T3",
          "source": "Society of Actuaries，Simplified Issue Underwriting；2017 Simplified Issue Composite Mortality Tables Report",
          "source_ref": "actuarial:incidence_rate_references[E2]"
